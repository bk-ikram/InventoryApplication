<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <%- include('../navBar') %>
  <h1><%= title %></h1>
  <!-- In views/index.ejs -->
   <button><a href="/authors/form">Add a new Author</a></button>
   <% if(locals.authors){ %> 
   <% locals.authors.forEach((a) => {%> 
    <div>
      <h3><a href="/mangas?authorid=<%=a.authorid%>"><%= a.name %></a></h3>
      <div>
        <button><a href="/authors/<%=a.authorid%>/update">Update</a></button>
        <form action="/authors/<%=a.authorid%>/delete" method="post">
          <button type="submit" onclick="return confirm('Are you sure you want to proceed?')">Delete</button>
        </form>
      </div>
    </div>


   <% })%>
   <% }%>
</body>
</html>
