<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
    <%
        const formAction = locals.author?.authorid
                            ? `/authors/${locals.author.authorid}/update`
                            : '/authors/form';
    %>
  <%- include('../navBar')%>
  <h1><%= title %></h1>
  <!-- In views/index.ejs -->
   <%- include("../errors.ejs") %>
    <form
        action = <%= formAction %> 
        method="post"
    >
        <p>
            <label for="author">
                <h2>Author: </h2>
            </label>
            <input 
                type="text" 
                id="author" 
                name="author"
                value= "<%= locals.author?.name ?? '' %>"
            >
        </p>
        <input type="hidden" name="authorid" value = "<%=locals.author?.authorid %>">
        <button type="submit">
            <%= locals.author?.authorid 
            ? "Update"
            : "Add"
            %>
        </button>
    </form>
</body>
</html>