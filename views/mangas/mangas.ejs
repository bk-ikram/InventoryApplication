<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <%- include('../navBar') %>
  <form action="/mangas/reset" method="post">
    <button type="submit" onclick="return confirm('Reset all data to stock?')">Reset Stock Data</button>
  </form>
  <h1><%= title %></h1>
  <!-- In views/index.ejs -->
   <button><a href="/mangas/form">Add a new Manga</a></button>
   <% if(locals.mangas){ %> 
   <% locals.mangas.forEach((m) => {%> 
    <div>
      <h3>Title: <%= m.title %></h3>
      <h3>Author: <a href="/mangas?authorid=<%=m.authorid%>"><%= m.author %></a></h3>
      <h3>Genres: <%= m.genres.join(', ')%></h3>
      <div>
        <!--form action="/mangas/<%=m.mangaid%>/update" method="get"><button type="submit">Update</button></form> -->
        <button><a href="/mangas/<%=m.mangaid%>/update">Update</a></button>
        <form action="/mangas/<%=m.mangaid%>/delete" method="post">
          <button type="submit" onclick="return confirm('Are you sure you want to proceed?')">Delete</button>
        </form>
      </div>
    </div>


   <% })%>
   <% }%>
</body>
</html>
